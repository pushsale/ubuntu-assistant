<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 có sẵn trên Windows 10 1903+ / Windows 11: chạy được ngay, không cần cài runtime -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SystemHud</AssemblyName>
    <RootNamespace>SystemHud</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>System HUD</Product>
    <Description>Bảng theo dõi CPU, RAM, GPU, Disk, Network vẽ thẳng lên desktop Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
